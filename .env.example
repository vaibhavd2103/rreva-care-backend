# Server
NODE_ENV=development
PORT=4000

# MongoDB (Prisma Mongo)
DATABASE_URL="mongodb+srv://asd:abc@cluster0.asd.mongodb.net/?appName=Cluster0"

# Auth
JWT_SECRET="secret"
JWT_EXPIRES_IN="3d"

# Admin seed user
ADMIN_EMAIL="abc@example.com"
ADMIN_PASSWORD="[assword]"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_SUCCESS_URL="http://localhost:3000/checkout/success"
STRIPE_CANCEL_URL="http://localhost:3000/checkout/cancel"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="abc@example.com"
SMTP_PASS="password"
EMAIL_FROM="something"

# Cloudinary (profile photo storage)
CLOUDINARY_CLOUD_NAME="..."
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."

# CORS: comma separated origins, or * for any
CORS_ORIGINS="*"
# Reverse proxies in front of the app (Render = 1)
TRUST_PROXY=1
